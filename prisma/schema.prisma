generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Auth (Auth.js v5 required tables) ───────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Core Domain ─────────────────────────────────────────────────────────────

model User {
  id             String   @id           // Supabase Auth UUID — provided on creation
  email          String   @unique
  hashedPassword String?                // unused when Supabase Auth is active
  name           String?
  image          String?
  emailVerified  DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  accounts     Account[]
  sessions     Session[]
  brandUsers   BrandUser[]
  bodyProfiles BodyProfile[]
  recommendationSessions RecommendationSession[]
  legalAcceptances LegalAcceptance[]
}

// ─── Legal / compliance ──────────────────────────────────────────────────────

enum LegalDocumentType {
  terms
  privacy
}

/// Immutable, append-only proof of clickwrap acceptance. One row per document
/// accepted per event; the server records the version in force at accept time.
model LegalAcceptance {
  id              String            @id @default(cuid())
  userId          String            @map("user_id")
  documentType    LegalDocumentType @map("document_type")
  documentVersion String            @map("document_version")
  acceptedAt      DateTime          @default(now()) @map("accepted_at")
  ipAddress       String?           @map("ip_address")
  userAgent       String?           @map("user_agent")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, documentType])
  @@map("legal_acceptances")
}

enum BrandPlan {
  free
  pro
  enterprise
}

model Brand {
  id           String    @id @default(cuid())
  name         String
  slug         String    @unique
  logoUrl      String?
  primaryColor String    @default("#000000")
  plan         BrandPlan @default(free)
  configuration Json     @default("{}")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  brandUsers   BrandUser[]
  products     Product[]
  sizeCharts   SizeChart[]
  bodyProfiles BodyProfile[]
  recommendationSessions RecommendationSession[]
}

enum BrandUserRole {
  owner
  admin
  editor
  viewer
}

model BrandUser {
  id      String        @id @default(cuid())
  userId  String
  brandId String
  role    BrandUserRole @default(viewer)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([userId, brandId])
}

model Product {
  id          String   @id @default(cuid())
  brandId     String
  externalId  String?
  name        String
  description String?
  category    String?
  subcategory String?
  tags        String[]
  imageUrl    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  brand    Brand            @relation(fields: [brandId], references: [id], onDelete: Cascade)
  variants ProductVariant[]
  outfitItems OutfitItem[]

  @@index([brandId])
  @@index([brandId, isActive])
}

enum StockStatus {
  inStock
  lowStock
  outOfStock
}

model ProductVariant {
  id               String      @id @default(cuid())
  productId        String
  externalId       String?
  sku              String?
  sizeLabel        String?
  color            String?
  additionalImages String[]
  stockStatus      StockStatus @default(inStock)
  price            Decimal?    @db.Decimal(10, 2)

  product     Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  outfitItems OutfitItem[]

  @@index([productId])
}

model SizeChart {
  id        String   @id @default(cuid())
  brandId   String
  category  String
  gender    String?
  chartJson Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId])
}

enum MeasurementProvider {
  stub
  ThreeDLook
  SizeStream
  custom
}

enum MeasurementMode {
  easy
  advanced
}

model BodyProfile {
  id                  String              @id @default(cuid())
  userId              String?
  brandId             String
  rawMeasurementsJson Json
  bodyShapeSummary    String?
  provider            MeasurementProvider @default(stub)
  measurementMode     MeasurementMode     @default(easy)
  /// Front photo path inside the private body-scans Supabase bucket. Never returned to clients.
  frontImagePath      String?
  /// Side photo path inside the private body-scans Supabase bucket. Never returned to clients.
  sideImagePath       String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  user  User?  @relation(fields: [userId], references: [id])
  brand Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)
  recommendationSessions RecommendationSession[]
  tryOnResults TryOnResult[]

  @@index([brandId])
}

enum SessionContext {
  PDP
  home
  quiz
  widget
}

enum SessionSource {
  webWidget
  app
  api
}

model RecommendationSession {
  id            String         @id @default(cuid())
  brandId       String
  userId        String?
  bodyProfileId String?
  context       SessionContext @default(widget)
  source        SessionSource  @default(webWidget)
  /// SHA-256 hash of the anonymous session token. Only set when userId is null.
  /// Used to prove ownership of the session for downstream calls (/api/outfits,
  /// /api/tryon) when the caller is not authenticated.
  ownerTokenHash String?
  createdAt     DateTime       @default(now())

  brand       Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  user        User?        @relation(fields: [userId], references: [id])
  bodyProfile BodyProfile? @relation(fields: [bodyProfileId], references: [id])
  outfits     Outfit[]

  @@index([brandId])
}

model Outfit {
  id                      String   @id @default(cuid())
  recommendationSessionId String
  title                   String
  description             String?
  rationale               String?
  createdAt               DateTime @default(now())

  recommendationSession RecommendationSession @relation(fields: [recommendationSessionId], references: [id], onDelete: Cascade)
  items                 OutfitItem[]
}

enum OutfitItemPosition {
  top
  bottom
  outerwear
  shoes
  accessory
  fullbody
}

model OutfitItem {
  id               String             @id @default(cuid())
  outfitId         String
  productId        String
  productVariantId String?
  position         OutfitItemPosition
  isRequired       Boolean            @default(true)

  outfit          Outfit          @relation(fields: [outfitId], references: [id], onDelete: Cascade)
  product         Product         @relation(fields: [productId], references: [id])
  productVariant  ProductVariant? @relation(fields: [productVariantId], references: [id])
  tryOnResults   TryOnResult[]
}

enum TryOnProvider {
  fal_fashn
  stub
}

enum TryOnQualityMode {
  fast
  balanced
  quality
}

model TryOnResult {
  id            String           @id @default(cuid())
  outfitItemId  String
  bodyProfileId String
  imageUrl      String
  provider      TryOnProvider    @default(fal_fashn)
  qualityMode   TryOnQualityMode @default(balanced)
  createdAt     DateTime         @default(now())

  outfitItem  OutfitItem  @relation(fields: [outfitItemId], references: [id], onDelete: Cascade)
  bodyProfile BodyProfile @relation(fields: [bodyProfileId], references: [id], onDelete: Cascade)

  @@index([outfitItemId])
  @@index([bodyProfileId])
}
