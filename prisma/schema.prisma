generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Auth (Auth.js v5 required tables) ───────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Core Domain ─────────────────────────────────────────────────────────────

model User {
  id             String   @id           // Supabase Auth UUID — provided on creation
  email          String   @unique
  hashedPassword String?                // unused when Supabase Auth is active
  name           String?
  image          String?
  emailVerified  DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Billing (Stripe). clientPlan is the durable source of truth for a shopper's
  // plan (webhook-maintained); the cookie is just a fast-path for UX.
  stripeCustomerId String? @unique @map("stripe_customer_id")
  clientPlan       String  @default("essential") @map("client_plan")

  /// Self-reported height in centimeters. Used as an input to the wardrobe-
  /// driven AI try-on so the model can render the selected size in
  /// proportion to the user's body (long-on-short, oversized-on-tall, etc.).
  /// Asked ONCE — either from the profile page or as a blocker in the first
  /// try-on selfie step — then reused. Nullable so existing users don't
  /// need a backfill; the try-on UI prompts when missing.
  heightCm         Int?    @map("height_cm")

  accounts     Account[]
  sessions     Session[]
  brandUsers   BrandUser[]
  bodyProfiles BodyProfile[]
  recommendationSessions RecommendationSession[]
  legalAcceptances LegalAcceptance[]
  subscription Subscription?
  wardrobeItems WardrobeItem[]
  wardrobeOutfits WardrobeOutfit[]
  wardrobeChatMessages WardrobeChatMessage[]
}

// ─── Legal / compliance ──────────────────────────────────────────────────────

enum LegalDocumentType {
  terms
  privacy
}

/// Immutable, append-only proof of clickwrap acceptance. One row per document
/// accepted per event; the server records the version in force at accept time.
model LegalAcceptance {
  id              String            @id @default(cuid())
  userId          String            @map("user_id")
  documentType    LegalDocumentType @map("document_type")
  documentVersion String            @map("document_version")
  acceptedAt      DateTime          @default(now()) @map("accepted_at")
  ipAddress       String?           @map("ip_address")
  userAgent       String?           @map("user_agent")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, documentType])
  @@map("legal_acceptances")
}

// ─── Billing (Stripe subscriptions) ──────────────────────────────────────────

enum SubscriptionStatus {
  active
  trialing
  past_due
  canceled
  incomplete
  incomplete_expired
  unpaid
  paused
}

/// One active subscription per shopper (userId) OR per brand (brandId) — never
/// both on the same row. Maintained by the Stripe webhook; the app reads
/// Brand.plan / User.clientPlan, which the webhook keeps in sync.
model Subscription {
  id                   String             @id @default(cuid())
  userId               String?            @unique @map("user_id")
  brandId              String?            @unique @map("brand_id")
  stripeCustomerId     String             @map("stripe_customer_id")
  stripeSubscriptionId String             @unique @map("stripe_subscription_id")
  stripePriceId        String             @map("stripe_price_id")
  plan                 String
  status               SubscriptionStatus
  currentPeriodEnd     DateTime?          @map("current_period_end")
  cancelAtPeriodEnd    Boolean            @default(false) @map("cancel_at_period_end")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  user  User?  @relation(fields: [userId], references: [id], onDelete: Cascade)
  brand Brand? @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([stripeCustomerId])
  @@map("subscriptions")
}

enum BrandPlan {
  free
  pro
  enterprise
}

model Brand {
  id           String    @id @default(cuid())
  name         String
  slug         String    @unique
  logoUrl      String?
  primaryColor String    @default("#000000")
  plan         BrandPlan @default(free)
  configuration Json     @default("{}")
  stripeCustomerId String? @unique @map("stripe_customer_id")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  brandUsers   BrandUser[]
  products     Product[]
  sizeCharts   SizeChart[]
  bodyProfiles BodyProfile[]
  recommendationSessions RecommendationSession[]
  subscription Subscription?
}

enum BrandUserRole {
  owner
  admin
  editor
  viewer
}

model BrandUser {
  id      String        @id @default(cuid())
  userId  String
  brandId String
  role    BrandUserRole @default(viewer)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([userId, brandId])
}

model Product {
  id          String   @id @default(cuid())
  brandId     String
  externalId  String?
  name        String
  description String?
  category    String?
  subcategory String?
  tags        String[]
  imageUrl    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  brand    Brand            @relation(fields: [brandId], references: [id], onDelete: Cascade)
  variants ProductVariant[]
  outfitItems OutfitItem[]
  wardrobeItems WardrobeItem[]

  @@index([brandId])
  @@index([brandId, isActive])
}

enum StockStatus {
  inStock
  lowStock
  outOfStock
}

model ProductVariant {
  id               String      @id @default(cuid())
  productId        String
  externalId       String?
  sku              String?
  sizeLabel        String?
  color            String?
  additionalImages String[]
  stockStatus      StockStatus @default(inStock)
  price            Decimal?    @db.Decimal(10, 2)

  product     Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  outfitItems OutfitItem[]
  wardrobeItems WardrobeItem[]

  @@index([productId])
}

model SizeChart {
  id        String   @id @default(cuid())
  brandId   String
  category  String
  gender    String?
  chartJson Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId])
}

enum MeasurementProvider {
  stub
  ThreeDLook
  SizeStream
  custom
}

enum MeasurementMode {
  easy
  advanced
}

model BodyProfile {
  id                  String              @id @default(cuid())
  userId              String?
  brandId             String
  rawMeasurementsJson Json
  bodyShapeSummary    String?
  provider            MeasurementProvider @default(stub)
  measurementMode     MeasurementMode     @default(easy)
  /// Front photo path inside the private body-scans Supabase bucket. Never returned to clients.
  frontImagePath      String?
  /// Side photo path inside the private body-scans Supabase bucket. Never returned to clients.
  sideImagePath       String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  user  User?  @relation(fields: [userId], references: [id])
  brand Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)
  recommendationSessions RecommendationSession[]
  tryOnResults TryOnResult[]

  @@index([brandId])
}

enum SessionContext {
  PDP
  home
  quiz
  widget
}

enum SessionSource {
  webWidget
  app
  api
}

model RecommendationSession {
  id            String         @id @default(cuid())
  brandId       String
  userId        String?
  bodyProfileId String?
  context       SessionContext @default(widget)
  source        SessionSource  @default(webWidget)
  /// SHA-256 hash of the anonymous session token. Only set when userId is null.
  /// Used to prove ownership of the session for downstream calls (/api/outfits,
  /// /api/tryon) when the caller is not authenticated.
  ownerTokenHash String?
  createdAt     DateTime       @default(now())

  brand       Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  user        User?        @relation(fields: [userId], references: [id])
  bodyProfile BodyProfile? @relation(fields: [bodyProfileId], references: [id])
  outfits     Outfit[]

  @@index([brandId])
}

model Outfit {
  id                      String   @id @default(cuid())
  recommendationSessionId String
  title                   String
  description             String?
  rationale               String?
  createdAt               DateTime @default(now())

  recommendationSession RecommendationSession @relation(fields: [recommendationSessionId], references: [id], onDelete: Cascade)
  items                 OutfitItem[]
}

enum OutfitItemPosition {
  top
  bottom
  outerwear
  shoes
  accessory
  fullbody
}

model OutfitItem {
  id               String             @id @default(cuid())
  outfitId         String
  productId        String
  productVariantId String?
  position         OutfitItemPosition
  isRequired       Boolean            @default(true)

  outfit          Outfit          @relation(fields: [outfitId], references: [id], onDelete: Cascade)
  product         Product         @relation(fields: [productId], references: [id])
  productVariant  ProductVariant? @relation(fields: [productVariantId], references: [id])
  tryOnResults   TryOnResult[]
}

enum TryOnProvider {
  fal_fashn
  stub
}

enum TryOnQualityMode {
  fast
  balanced
  quality
}

model TryOnResult {
  id            String           @id @default(cuid())
  outfitItemId  String
  bodyProfileId String
  imageUrl      String
  provider      TryOnProvider    @default(fal_fashn)
  qualityMode   TryOnQualityMode @default(balanced)
  createdAt     DateTime         @default(now())

  outfitItem  OutfitItem  @relation(fields: [outfitItemId], references: [id], onDelete: Cascade)
  bodyProfile BodyProfile @relation(fields: [bodyProfileId], references: [id], onDelete: Cascade)

  @@index([outfitItemId])
  @@index([bodyProfileId])
}

// ─── Digital Wardrobe ────────────────────────────────────────────────────────
// Each user's personal closet. A wardrobe item can be either a CERTIFIED item
// (linked to a Brand catalog Product) OR a USER_PHOTO item (clothing the
// shopper already owns, uploaded from two photos). Both types are usable in
// outfit creation. This is now the primary product surface — sizing is built
// on top of this layer, not the other way round.

enum WardrobeItemSourceType {
  certified
  user_photo
}

enum WardrobeItemProcessingStatus {
  pending_upload  // record created, photos not yet uploaded
  processing      // photos uploaded, AI pipeline running (bg removal, category, etc.)
  needs_review    // pipeline succeeded but confidence is low — user should confirm
  ready           // item visible in wardrobe + selectable in outfit builder
  failed          // pipeline could not extract a usable asset
}

model WardrobeItem {
  id                String                       @id @default(cuid())
  userId            String                       @map("user_id")
  sourceType        WardrobeItemSourceType       @map("source_type")

  // Certified path — link into the brand catalog (optional, only for sourceType=certified).
  productId         String?                      @map("product_id")
  productVariantId  String?                      @map("product_variant_id")

  // User-photo path — paths inside the private wardrobe-items Supabase bucket.
  // Never returned to clients; signed URLs are minted at read time.
  frontImagePath    String?                      @map("front_image_path")
  backImagePath     String?                      @map("back_image_path")
  /// Processed visual (background-removed + cropped). Used as the primary
  /// thumbnail in the wardrobe + in outfit picker. Falls back to frontImage.
  processedAssetPath String?                     @map("processed_asset_path")

  // Common metadata captured / inferred at item creation. Brand and nickname
  // are optional even for certified items so users can rename them.
  category          String
  subcategory       String?
  color             String?
  brand             String?
  nickname          String?
  /// The size THIS user owns the piece in. Free-form so brands using
  /// non-standard taxonomies (38/40, XS/S/M/L, "petite small") all fit.
  /// New user_photo uploads require it via the CaptureFlow; certified
  /// items inherit it from the selected ProductVariant. Pre-existing rows
  /// (saved before this column shipped) stay nullable; UI shows them as
  /// "size unknown" until edited.
  size              String?

  /// Granular clothing type (T-shirt, Hoodie, Loafers, Denim jeans…).
  /// More specific than `category` (which is the outfit-slot bucket —
  /// top/bottom/etc). Free-form so "Other" lets users type anything.
  /// Fed straight into the outfit chatbot prompt so it can reason about
  /// silhouette + dress code more precisely than category alone.
  type              String?
  /// Free-text description (fit, pattern, styling notes, occasion).
  /// Surfaced verbatim to the chatbot — "ribbed knit, cropped" changes
  /// what gets recommended.
  description       String?  @db.Text
  /// Optional fabric / textile. Improves chatbot reasoning about
  /// material compatibility (denim+cotton OK, leather+silk fussy) and
  /// seasonality. Free-form so "Other" lets users type a specific blend.
  material          String?

  /// Pipeline state. Only meaningful for user_photo items; certified items
  /// are written with `ready` directly. The wardrobe UI uses this to gate
  /// whether the item is selectable in the outfit builder (usableInOutfit
  /// is derived: processingStatus === 'ready').
  processingStatus  WardrobeItemProcessingStatus @default(ready) @map("processing_status")

  createdAt         DateTime                     @default(now()) @map("created_at")
  updatedAt         DateTime                     @updatedAt @map("updated_at")

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  product         Product?         @relation(fields: [productId], references: [id])
  productVariant  ProductVariant?  @relation(fields: [productVariantId], references: [id])
  outfitItems     WardrobeOutfitItem[]

  @@index([userId])
  @@index([userId, sourceType])
  @@index([userId, processingStatus])
  @@map("wardrobe_items")
}

// ─── Wardrobe Outfits ────────────────────────────────────────────────────────
// A saved "look" — a combination of wardrobe items the user assembled. Lives
// on the user (not on a brand). The outfit's value isn't a styling
// recipe — it's the AI-generated picture of the SHOPPER wearing those
// pieces, produced from a selfie they uploaded. Without the generated
// image an outfit is half a product; the columns below capture that step.

enum WardrobeOutfitGenerationStatus {
  /// No try-on attempted yet (legacy outfits saved before AI try-on, or
  /// drafts where the user hasn't uploaded a selfie).
  none
  /// Selfie uploaded, AI call about to start.
  pending
  /// AI provider request in flight.
  generating
  /// Generated image is in the bucket; outfit is showable.
  ready
  /// Last attempt failed — see `generationError`.
  failed

  @@map("wardrobe_outfit_generation_status")
}

model WardrobeOutfit {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  title     String
  occasion  String?

  /// Snapshot of the user's height (cm) at the moment this outfit was
  /// generated. Decoupled from User.heightCm so re-rendering an old outfit
  /// uses the height the user actually had at generation time, not their
  /// current value. Nullable for legacy outfits saved before this column.
  userHeightCm       Int?    @map("user_height_cm")

  /// Private-bucket path to the SELFIE the user uploaded as the base
  /// image for the AI try-on. Never returned raw to clients — signed at
  /// read time, same posture as wardrobe-items photos.
  selfieImagePath    String? @map("selfie_image_path")
  /// Private-bucket path to the AI-generated image of the user wearing
  /// the selected items. Same signed-URL posture.
  generatedImagePath String? @map("generated_image_path")
  /// Current state of the try-on pipeline. `ready` means generatedImagePath
  /// can be signed and rendered to the user.
  generationStatus   WardrobeOutfitGenerationStatus @default(none) @map("generation_status")
  /// Provider-reported error string when status = failed. Capped and
  /// scrubbed before storage so no provider PII / keys leak in.
  generationError    String? @map("generation_error")
  /// Which provider produced the current generated image — "gemini" today,
  /// "fal" once that's wired. Lets us track quality per provider over time.
  generationProvider String? @map("generation_provider")
  generatedAt        DateTime? @map("generated_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  items WardrobeOutfitItem[]

  @@index([userId])
  @@map("wardrobe_outfits")
}

model WardrobeOutfitItem {
  id              String   @id @default(cuid())
  outfitId        String   @map("outfit_id")
  wardrobeItemId  String   @map("wardrobe_item_id")
  /// Logical slot for this item in the look. Free-form so the UI can evolve
  /// without a migration — typical values: "top", "bottom", "shoes", "accessory".
  position        String
  /// Snapshot of the WardrobeItem.size at the time the outfit was built.
  /// Decoupled from the live item so editing/replacing the wardrobe item
  /// later doesn't rewrite history on every outfit that used it.
  size            String?
  createdAt       DateTime @default(now()) @map("created_at")

  outfit       WardrobeOutfit @relation(fields: [outfitId], references: [id], onDelete: Cascade)
  wardrobeItem WardrobeItem   @relation(fields: [wardrobeItemId], references: [id], onDelete: Cascade)

  @@index([outfitId])
  @@index([wardrobeItemId])
  @@map("wardrobe_outfit_items")
}

// ─── Enterprise sales enquiries ──────────────────────────────────────────────
// Captured from the "Contact team" CTA on the Premier (Enterprise) brand plan
// card. Persisted so ops can follow up without depending on email plumbing
// (no email infra wired up yet at the time this was added). Plain table, no
// PII beyond what the lead voluntarily submitted; service-role-only access.
//
// userId is OPTIONAL because the enquiry CTA appears in the pro-workspace
// pricing page (signed-in brand operator) — anonymous enquiries from the
// public /pricing page would land here too if that surface is added later.

model EnterpriseEnquiry {
  id        String   @id @default(cuid())
  /// Set when an authenticated brand operator submitted the form.
  userId    String?  @map("user_id")
  name      String
  email     String
  company   String
  message   String   @db.Text
  /// Captured at submit time for spam triage. Not displayed.
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([email])
  @@map("enterprise_enquiries")
}

// ─── Wardrobe Chat ───────────────────────────────────────────────────────────
// Conversations with the AI outfit assistant. One row per message; we don't
// model "threads" yet — every user has one rolling history. Premium-only
// (Fashion / Model plans). The assistant's reply can carry references to
// specific WardrobeItem ids in `recommendedItemIds` so the UI can render
// "recommended pieces" chips below the message.

model WardrobeChatMessage {
  id                    String   @id @default(cuid())
  userId                String   @map("user_id")
  /// "user" or "assistant". No enum so it's cheap to add "system" or
  /// "tool" later if the prompt scheme evolves.
  role                  String
  content               String   @db.Text
  /// IDs of WardrobeItems the assistant cited in this reply. Plain string
  /// array (no FK) so deleting an item later doesn't blow away history —
  /// the UI just skips ids it can't resolve.
  recommendedItemIds    String[] @default([]) @map("recommended_item_ids")
  createdAt             DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("wardrobe_chat_messages")
}
